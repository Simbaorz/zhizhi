# Zhizhi Backend bootstrap environment example.
# Copy this file to .env and keep real credentials out of Git.
# Database, Redis, storage, and encryption settings belong in conf/*.yml.

# Shared backend bootstrap
PROJECT_NAME=zhizhi
PROJECT_HOME=.
MODE=dev
TIMEZONE=Asia/Shanghai
CONFIG_SOURCE=local

# Admin API bootstrap
ADMIN_SESSION_COOKIE_SECURE=false

# Local backend process endpoints used by scripts/start-local.sh
WEB_API_HOST=127.0.0.1
WEB_API_PORT=8000
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8001
WORKER_LOG_LEVEL=INFO

# Optional Apollo bootstrap. Set CONFIG_SOURCE=apollo before enabling these.
# APOLLO_BASE_URL=http://127.0.0.1:8080
# APOLLO_CLUSTER=default
# APOLLO_NAMESPACES=application.yml
# APOLLO_ACCESS_KEY_SECRET=
# APOLLO_CLIENT_IP=
# APOLLO_LABEL=
# APOLLO_STARTUP_TIMEOUT_SECONDS=10
# APOLLO_LONG_POLL_TIMEOUT_SECONDS=70
# APOLLO_REFRESH_INTERVAL_SECONDS=300
# APOLLO_CACHE_DIR=var/apollo
# APOLLO_STARTUP_POLICY=cache_or_fail

# The root startup script maps these service-specific values to APOLLO_APP_ID.
# WEB_APOLLO_APP_ID=zhizhi-web-api
# ADMIN_APOLLO_APP_ID=zhizhi-admin-api
# WORKER_APOLLO_APP_ID=zhizhi-worker

# CONFIG_FILE is intentionally omitted because each backend process uses its own
# root conf/web.yml, conf/admin.yml, or conf/worker.yml file.
