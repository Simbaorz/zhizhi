{
  "name": "zhizhi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:admin": "pnpm --filter zhizhi-admin-web dev",
    "dev:web": "pnpm --filter zhizhi-web dev",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "build": "pnpm --recursive --if-present run build"
  }
}
